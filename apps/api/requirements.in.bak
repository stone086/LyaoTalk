# ========================================================================
# LiaoT API requirements — pinned and CVE-checked
# Last security review: May 2026
#
# Each pin justified by either:
#   - Latest stable that's been quiet for 30+ days (no immediate CVEs)
#   - A specific CVE patch we need to be at-or-above
#
# Re-run pip-audit + safety on every release.
# ========================================================================

# Core framework
# starlette CVE-2025-54121 (multipart DoS) fixed in 0.47.2
# starlette CVE-2025-62727 (StaticFiles Range parsing DoS) fixed in 0.49.1
# fastapi 0.121.x is the first release that allows starlette >= 0.49.1
fastapi==0.121.0
uvicorn[standard]==0.32.0

# Database
sqlalchemy[asyncio]==2.0.36
asyncpg==0.30.0
alembic==1.14.0

# Validation
pydantic==2.9.2
pydantic-settings==2.6.0

# Auth & security
