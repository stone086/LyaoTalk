# =============================================================================
# Lyao Talk environment template (internal service names retain lyaotalk for compatibility)
# Copy to .env and edit values before running install.sh
# =============================================================================

# Public access domain (required)
DOMAIN=chat.example.com
PUBLIC_DOMAIN=chat.example.com

# Email used by Let's Encrypt for certificate notices (required)
EMAIL=you@example.com

# XMPP domain (defaults to DOMAIN in installer when left empty)
XMPP_DOMAIN=chat.example.com

# ---------------------------------------------------------------------------
# Secrets (leave empty to auto-generate during install)
# ---------------------------------------------------------------------------
DB_PASS=
# Alias accepted by preflight/env wizard; install.sh syncs it with DB_PASS.
POSTGRES_PASSWORD=
REDIS_PASS=
SECRET_KEY=
XMPP_ADMIN_PASS=
TURN_SECRET=

# MinIO credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Application config (usually set by install.sh, override if needed)
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://lyaotalk:changeme@localhost:5432/lyaotalk
# REDIS_URL=redis://localhost:6379/0
# CORS_ORIGINS=["https://chat.example.com"]
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=changeme123
# MINIO_BUCKET=lyaotalk-files
# MINIO_SECURE=false
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
# XMPP_REGISTRATION_ENABLED=true
# PUSH_SHARED_SECRET=

# Admin login for Lyao Talk admin panel.
# Use ADMIN_PASS_HASH (preferred) — argon2 or bcrypt encoded hash. The
# installer generates this for you and shows the plaintext password once
# during install. To set manually, generate via:
#     python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('your-password'))"
# ADMIN_PASS (plaintext) is supported for backwards compatibility but
# discouraged — a leaked .env immediately surrenders admin access.
# When both are set, ADMIN_PASS_HASH wins.
ADMIN_USER=admin
ADMIN_PASS_HASH=
# ADMIN_PASS=  # legacy plaintext — leave empty when using ADMIN_PASS_HASH
APP_USER=lyaotalk

# Optional alert receiver (future watchdog/email integrations)
ALERT_EMAIL=

# AI provider runtime config (used by rebuild milestone)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional database pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Optional remote backup target for rclone (example: remote:lyaotalk-backups)
BACKUP_REMOTE=


# =====================================================
# SSO / LDAP (KILLER-05)
# =====================================================
# OIDC (Keycloak / Authentik / Auth0 / Okta)
OIDC_ENABLED=false
OIDC_ISSUER=https://auth.example.com/realms/main
OIDC_CLIENT_ID=lyaotalk
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://chat.example.com/sso/oidc/callback
OIDC_LABEL="Single Sign-On"
AUTO_PROVISION_OIDC=false

# LDAP (Active Directory / OpenLDAP)
LDAP_ENABLED=false
LDAP_SERVER=ldap://ldap.example.com
LDAP_BIND_DN_TEMPLATE=uid={username},ou=People,dc=example,dc=com
LDAP_USER_BASE=ou=People,dc=example,dc=com
LDAP_LABEL="Corporate Login"
AUTO_PROVISION_LDAP=false

FRONTEND_URL=https://chat.example.com

# =====================================================
# Web Push (VAPID) — auto-generated by install.sh
# =====================================================
# Leave empty if install.sh runs; fill manually for Docker/manual deploy.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=admin@chat.example.com

# =====================================================
# SFU (optional, for group calls with 6+ participants)
# =====================================================
SFU_URL=

# Build / package version
APP_VERSION=2.3.5

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
PERF_QUERY_COUNT_ENABLED=true
PERF_QUERY_WARN_THRESHOLD=10
PERF_SLOW_SQL_MS=250
# Optional external Prometheus scrape IP/CIDR, e.g. 203.0.113.10/32.
PROMETHEUS_ALLOW_CIDR=
